{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumina",
  "version": "0.2.0",
  "identifier": "dev.lumina.app",
  "mainBinaryName": "lumina",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumina",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Lumina Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local development environment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../resources/": "resources/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../../packaging/windows/nsis/hooks.nsh",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "fragmentPaths": [
          "../../../packaging/windows/wix/lumina-hooks.wxs"
        ],
        "componentGroupRefs": [
          "LuminaHooks"
        ]
      }
    },
    "macOS": {
      "entitlements": "../../../packaging/macos/entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libnss3-tools"
        ],
        "files": {
          "/usr/share/polkit-1/actions/dev.lumina.app.helper.policy": "../../../packaging/linux/dev.lumina.app.helper.policy"
        }
      },
      "rpm": {
        "depends": [
          "nss-tools"
        ],
        "files": {
          "/usr/share/polkit-1/actions/dev.lumina.app.helper.policy": "../../../packaging/linux/dev.lumina.app.helper.policy"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MzA3REYyNTM3RUE0QjcKUldTM3BINVQ4bjB3eVNJQXpaeFFHbmg1WEc1TERnalBXekNsKzEzSG9pZElXTHZmSUlQaHBkRUUK",
      "endpoints": [
        "https://github.com/SaanPrasanna/Lumina/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
