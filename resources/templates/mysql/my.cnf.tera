# Generated by Lumina for {{ engine_name }} {{ version }}; rewritten on every start.
# Put your own settings in {{ custom_cnf }} — it is included last and never touched.

[mysqld]
basedir = "{{ basedir }}"
datadir = "{{ datadir }}"
port = {{ port }}
# Local development only: never reachable from the network.
bind-address = 127.0.0.1
{%- if socket %}
socket = "{{ socket }}"
{%- endif %}
tmpdir = "{{ tmpdir }}"
log-error = "{{ error_log }}"
pid-file = "{{ pid_file }}"

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# Clients connect as root@127.0.0.1; no reverse DNS lookup on connect.
skip-name-resolve
max_connections = 200
max_allowed_packet = 256M
{%- if mysql %}
# The X Protocol listener (port 33060) is not needed and would be one more port.
mysqlx = OFF
{%- endif %}

# Sized from this machine's RAM (12.5 %, at least 128 MB).
innodb_buffer_pool_size = {{ buffer_pool_mb }}M
innodb_log_buffer_size = 16M
innodb_flush_log_at_trx_commit = 2
{%- if low_memory %}
# Less than 8 GB of RAM: skip the instrumentation tables.
performance_schema = OFF
{%- endif %}

[client]
port = {{ port }}
host = 127.0.0.1
{%- if socket %}
socket = "{{ socket }}"
{%- endif %}
default-character-set = utf8mb4

!include {{ custom_cnf }}
