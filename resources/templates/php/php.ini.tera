; php.ini for PHP {{ version }}, generated by Lumina on first use.
; Lumina never overwrites this file: edit freely. Delete it to regenerate.
; PHP_FCGI_CHILDREN / PHP_FCGI_MAX_REQUESTS are set in Lumina's settings, not here.

[PHP]
engine = On
short_open_tag = Off
expose_php = Off
memory_limit = 512M
max_execution_time = 120
max_input_time = 120
max_input_vars = 5000
post_max_size = 256M
upload_max_filesize = 256M
default_charset = "UTF-8"
variables_order = "EGPCS"
request_order = "GP"

; Development defaults: show everything.
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{ error_log }}"

cgi.fix_pathinfo = 1
{%- if windows %}
fastcgi.impersonate = 1
{%- endif %}

extension_dir = "{{ extension_dir }}"
upload_tmp_dir = "{{ tmp_dir }}"
sys_temp_dir = "{{ tmp_dir }}"

{% for ext in extensions -%}
extension={{ ext }}
{% endfor %}
{%- if mysql_socket %}
[MySQL]
; Lumina's MySQL / MariaDB socket, so "localhost" connections find the server.
mysqli.default_socket = "{{ mysql_socket }}"
pdo_mysql.default_socket = "{{ mysql_socket }}"
{% endif %}
[Date]
date.timezone = UTC

[Session]
session.save_path = "{{ tmp_dir }}"

[opcache]
{%- if opcache_extension %}
zend_extension=opcache
{%- endif %}
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 128
opcache.max_accelerated_files = 20000
; Check file timestamps on every request so code edits show up immediately.
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
