# Generated by Lumina; rewritten on every start and reload — do not edit.
# Add your own server blocks as .conf files in {{ sites_dir }}
# (Lumina only manages files whose names start with "auto." and "00-localhost").

{%- if windows %}
# nginx for Windows uses one worker; more would not accept connections.
worker_processes  1;
{%- else %}
worker_processes  auto;
{%- endif %}
pid               logs/nginx.pid;
error_log         "{{ logs_dir }}/nginx_error.log" notice;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    charset       utf-8;

    access_log    "{{ logs_dir }}/nginx_access.log";
    sendfile      on;
    keepalive_timeout     65;
    client_max_body_size  256m;
    server_names_hash_bucket_size  128;
{%- if ssl %}

    # HTTPS for localhost and every site (certificates from Lumina's local CA).
    ssl_protocols              TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers  off;
{%- endif %}

    # Temporary files stay inside Lumina's etc/nginx/temp.
    client_body_temp_path  temp/client_body;
    proxy_temp_path        temp/proxy;
    fastcgi_temp_path      temp/fastcgi;
    uwsgi_temp_path        temp/uwsgi;
    scgi_temp_path         temp/scgi;

    # PHP FastCGI pool. One connection per request, on purpose: a PHP worker
    # recycled by PHP_FCGI_MAX_REQUESTS exits, and on Windows a process exit
    # can reset a kept-alive connection and cut off a response nginx is still
    # reading; nginx then has to drop the client's connection. A new connection
    # to 127.0.0.1 per request costs microseconds. max_fails=0: a worker being
    # replaced never marks the pool as down.
    upstream php_upstream {
        server  127.0.0.1:{{ php_port }} max_fails=0;
    }

    # A request shared through a Lumina tunnel (the tunnel adds
    # X-Lumina-Tunnel) reaches PHP with the public host and HTTPS, so links,
    # assets and redirects point at the public address. Other requests are
    # unchanged (see fastcgi_params).
    map $http_x_lumina_tunnel $lumina_host {
        ""       $http_host;
        default  $http_x_forwarded_host;
    }
    map $http_x_lumina_tunnel $lumina_scheme {
        ""       $scheme;
        default  https;
    }
    map $http_x_lumina_tunnel $lumina_https {
        ""       $https;
        default  on;
    }
    map $http_x_lumina_tunnel $lumina_port {
        ""       $server_port;
        default  443;
    }

    include "{{ sites_dir }}/*.conf";
}
