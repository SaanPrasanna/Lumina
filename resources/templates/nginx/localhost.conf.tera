# Generated by Lumina — http://localhost serves the projects folder.
{%- if ssl %}
# Certificate serial {{ localhost_serial }}.
{%- endif %}

server {
    listen       127.0.0.1:{{ http_port }} default_server;
{%- if ssl %}
    listen       127.0.0.1:{{ https_port }} ssl default_server;
    http2        on;
    ssl_certificate      "{{ localhost_cert }}";
    ssl_certificate_key  "{{ localhost_key }}";
{%- endif %}
    server_name  localhost;
    root         "{{ www_root }}";
    index        index.php index.html index.htm;

    location / {
        try_files  $uri $uri/ =404;
        autoindex  on;
    }

    location ~ \.php$ {
        try_files  $uri =404;
        include    fastcgi.conf;
    }
}
