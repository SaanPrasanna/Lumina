# Generated by Lumina for the project folder "{{ name }}"; rewritten or deleted
# whenever the projects folder changes — do not edit.
# To customise this site, copy this file to {{ user_file }} in this folder and
# edit the copy: Lumina then stops writing {{ auto_file }} and never touches yours.
{%- if ssl %}
# Certificate serial {{ serial }}, valid until {{ cert_expires }}.
{%- endif %}

server {
    listen       127.0.0.1:{{ http_port }};
{%- if ssl %}
    listen       127.0.0.1:{{ https_port }} ssl;
    http2        on;
    ssl_certificate      "{{ cert }}";
    ssl_certificate_key  "{{ key }}";
{%- endif %}
    server_name  {{ domain }} *.{{ domain }};
    root         "{{ root }}";
    index        index.php index.html index.htm;
{%- if ssl and force_https %}

    # "Force HTTPS" is on: plain HTTP is redirected.
    if ($scheme = http) {
        return  301 https://$host{{ https_suffix }}$request_uri;
    }
{%- endif %}

    # Front controllers (Laravel, Symfony, WordPress): unknown paths go to index.php.
    location / {
        try_files  $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        try_files  $uri =404;
        include    fastcgi.conf;
    }

    location ~ /\.(?!well-known) {
        deny  all;
    }
}
