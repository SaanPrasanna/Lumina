# Generated by Lumina: PHP handling shared by every site, without the pool
# to send requests to (fastcgi.conf adds the shared pool; sites with their own
# PHP version add theirs).

include        fastcgi_params;
fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
fastcgi_param  REDIRECT_STATUS  200;

# No fastcgi_keep_conn: one connection per request (see nginx.conf). If PHP is
# momentarily not accepting (a worker being replaced), retry instead of failing
# the request. Retries happen only before anything was sent to the client.
fastcgi_next_upstream        error timeout invalid_header;
fastcgi_next_upstream_tries  3;

fastcgi_connect_timeout  10s;
fastcgi_send_timeout     300s;
fastcgi_read_timeout     300s;
fastcgi_buffers          16 16k;
fastcgi_buffer_size      32k;
