# Generated by Lumina — http://localhost serves the projects folder.
{%- if db_ui %}

# phpMyAdmin {{ db_ui_version }}: the newest installed one that runs on PHP {{ db_ui_php }}.
<Directory "{{ db_ui_dir }}">
    Options FollowSymLinks
    DirectoryIndex index.php
    AllowOverride All
    # Database tools answer this computer only (LAN sharing included).
    Require local
</Directory>
<DirectoryMatch "^{{ db_ui_dir }}/(libraries|setup/lib|templates|tmp|vendor)/">
    Require all denied
</DirectoryMatch>
{%- endif %}
{%- if adminer_dir %}

# Adminer: one PHP file for MySQL, MariaDB, PostgreSQL and SQLite.
<Directory "{{ adminer_dir }}">
    DirectoryIndex index.php
    Require local
</Directory>
{%- endif %}
{%- if ssl %}
# Certificate serial {{ localhost_serial }}.
{%- endif %}

<VirtualHost {{ vhost_ip }}:{{ http_port }}>
    ServerName localhost
    DocumentRoot "{{ www_root }}"
{%- if db_ui %}
    Alias /phpmyadmin "{{ db_ui_dir }}"
{%- endif %}
{%- if adminer_dir %}
    Alias /adminer "{{ adminer_dir }}"
{%- endif %}

    <Directory "{{ www_root }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
{%- if ssl %}

<VirtualHost {{ vhost_ip }}:{{ https_port }}>
    ServerName localhost
    DocumentRoot "{{ www_root }}"
{%- if db_ui %}
    Alias /phpmyadmin "{{ db_ui_dir }}"
{%- endif %}
{%- if adminer_dir %}
    Alias /adminer "{{ adminer_dir }}"
{%- endif %}
    SSLEngine on
    SSLCertificateFile "{{ localhost_cert }}"
    SSLCertificateKeyFile "{{ localhost_key }}"

    <Directory "{{ www_root }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
{%- endif %}
