# Generated by Lumina — http://localhost serves the projects folder.
{%- if db_ui %}

# phpMyAdmin {{ db_ui_version }}: the newest installed one that runs on PHP {{ db_ui_php }}.
<Directory "{{ db_ui_dir }}">
    Options FollowSymLinks
    DirectoryIndex index.php
    AllowOverride All
    Require all granted
</Directory>
<DirectoryMatch "^{{ db_ui_dir }}/(libraries|setup/lib|templates|tmp|vendor)/">
    Require all denied
</DirectoryMatch>
{%- endif %}
{%- if ssl %}
# Certificate serial {{ localhost_serial }}.
{%- endif %}

<VirtualHost 127.0.0.1:{{ http_port }}>
    ServerName localhost
    DocumentRoot "{{ www_root }}"
{%- if db_ui %}
    Alias /phpmyadmin "{{ db_ui_dir }}"
{%- endif %}

    <Directory "{{ www_root }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
{%- if ssl %}

<VirtualHost 127.0.0.1:{{ https_port }}>
    ServerName localhost
    DocumentRoot "{{ www_root }}"
{%- if db_ui %}
    Alias /phpmyadmin "{{ db_ui_dir }}"
{%- endif %}
    SSLEngine on
    SSLCertificateFile "{{ localhost_cert }}"
    SSLCertificateKeyFile "{{ localhost_key }}"

    <Directory "{{ www_root }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
{%- endif %}
