# Generated by Lumina — http://localhost serves the projects folder.
{%- if ssl %}
# Certificate serial {{ localhost_serial }}.
{%- endif %}

<VirtualHost 127.0.0.1:{{ http_port }}>
    ServerName localhost
    DocumentRoot "{{ www_root }}"

    <Directory "{{ www_root }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
{%- if ssl %}

<VirtualHost 127.0.0.1:{{ https_port }}>
    ServerName localhost
    DocumentRoot "{{ www_root }}"
    SSLEngine on
    SSLCertificateFile "{{ localhost_cert }}"
    SSLCertificateKeyFile "{{ localhost_key }}"

    <Directory "{{ www_root }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
{%- endif %}
