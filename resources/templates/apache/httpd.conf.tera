# Generated by Lumina; rewritten on every start — do not edit.
# Add your own <VirtualHost> blocks as .conf files in {{ sites_dir }}
# (Lumina only manages files whose names start with "auto." and "00-localhost").

Define SRVROOT "{{ server_root }}"
ServerRoot "${SRVROOT}"
Listen 127.0.0.1:{{ http_port }}
ServerName localhost:{{ http_port }}
PidFile "{{ pid_file }}"

{% for module in modules -%}
LoadModule {{ module }}_module modules/mod_{{ module }}.so
{% endfor %}
<IfModule unixd_module>
    User daemon
    Group daemon
</IfModule>

ServerAdmin admin@localhost
ErrorLog "{{ logs_dir }}/apache_error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog "{{ logs_dir }}/apache_access.log" combined

TypesConfig "${SRVROOT}/conf/mime.types"
AddDefaultCharset UTF-8
AddType application/x-compress .Z
AddType application/x-gzip .gz .tgz
{%- if windows %}

# Windows: the default accept filter and sendfile misbehave with some antivirus
# and network stacks.
AcceptFilter http none
AcceptFilter https none
EnableSendfile Off
EnableMMAP Off
{%- endif %}

Timeout 300
KeepAlive On
MaxKeepAliveRequests 500
KeepAliveTimeout 5
LimitRequestBody 268435456

<Directory />
    AllowOverride none
    Require all denied
</Directory>

<Files ".ht*">
    Require all denied
</Files>

DirectoryIndex index.php index.html index.htm

# PHP FastCGI pool, shared by every site. Deliberately one connection per
# request (no enablereuse): a PHP worker recycled by PHP_FCGI_MAX_REQUESTS
# resets its connection, and mod_proxy_fcgi cannot retry a reused connection,
# so reuse turned recycling into 503s and hung requests. A fresh connection to
# 127.0.0.1 costs microseconds.
<Proxy "fcgi://127.0.0.1:{{ php_port }}/" enablereuse=off retry=0>
</Proxy>
# php-cgi is not PHP-FPM: send plain filesystem paths in SCRIPT_FILENAME instead
# of FPM's "proxy:fcgi://..." form, which php-cgi answers with "No input file
# specified." (404).
ProxyFCGIBackendType GENERIC
{%- if windows %}
# On Windows GENERIC still leaves a slash before the drive letter
# ("/C:/www/index.php"), which is not a valid path; strip it.
ProxyFCGISetEnvIf "reqenv('SCRIPT_FILENAME') =~ m#^/([A-Za-z]:/.*)$#" SCRIPT_FILENAME "$1"
{%- endif %}

<FilesMatch "\.php$">
    <If "-f %{REQUEST_FILENAME}">
        SetHandler "proxy:fcgi://127.0.0.1:{{ php_port }}/"
    </If>
</FilesMatch>

IncludeOptional "{{ sites_dir }}/*.conf"
