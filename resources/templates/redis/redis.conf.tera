# Generated by Lumina for Redis {{ version }}; rewritten on every start.
# Put your own settings in {{ custom_conf }} — it is included last and never touched.

port {{ port }}
# Local development only: never reachable from the network.
bind 127.0.0.1
protected-mode yes
# Windows builds cannot raise the open-files limit past ~3200; stay below it
# so Redis does not warn on every start.
maxclients 3000
daemonize no

dir "{{ data_dir }}"
logfile "{{ log_file }}"
loglevel notice

# Snapshot now and then so data survives restarts; SHUTDOWN also saves.
save 3600 1 300 100 60 10000
appendonly no

include "{{ custom_conf }}"
