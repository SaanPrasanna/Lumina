{
  "name": "lumina-monorepo",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lumina/desktop tauri dev",
    "build": "pnpm --filter @lumina/desktop tauri build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "icons": "pnpm --filter @lumina/desktop tauri icon ../../assets/branding/app-icon.svg",
    "icons:tray": "pnpm --filter @lumina/desktop tauri icon ../../assets/branding/tray-template.svg -o ../../target/tray-icons && node -e \"require('fs').copyFileSync('target/tray-icons/64x64.png','apps/desktop/src-tauri/icons/tray-template.png')\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
